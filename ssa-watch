#!/usr/bin/env bash
# Watch open, non-draft PRs involving you. Notifies on new ones, on @-mentions, on
# replies in review threads you commented in, and on comments and reviews on your PRs. Auto-approves PRs carrying the approve
# label (unless authored by you, you requested changes, or it touches an -x path).
set -euo pipefail

usage() {
  cat <<EOF
Usage: ssa-watch -r owner/repo [-r owner/repo]... [-i seconds] [-l label] [-x path]... [-n]
  -r  repo to watch, repeatable (required)
  -i  poll interval in seconds (default: 60)
  -l  label that triggers auto-approve (default: ssa-ship)
  -x  never auto-approve PRs changing files under this path, repeatable
  -n  dry run: log instead of approving
EOF
}

repos=()
interval=60
approve_label="ssa-ship"
excluded_paths=()
dry_run=false

while getopts "r:i:l:x:nh" opt; do
  case $opt in
    r) repos+=("$OPTARG") ;;
    i) interval=$OPTARG ;;
    l) approve_label=$OPTARG ;;
    x) excluded_paths+=("${OPTARG%/}") ;;
    n) dry_run=true ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
if [ ${#repos[@]} -eq 0 ]; then
  usage >&2
  exit 1
fi

state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/ssa-watch"
repos_key=$(printf '%s\n' "${repos[@]}" | sort | shasum | cut -c1-12)
seen_file="$state_dir/seen-$repos_key"
events_file="$state_dir/events-$repos_key"
mkdir -p "$state_dir"

me=$(gh api user -q .login)
failed_approvals=" "
blocked_approvals=" "

is_tty=false
if [ -t 1 ]; then
  is_tty=true
  c_reset=$'\e[0m' c_bold=$'\e[1m' c_dim=$'\e[2m' c_red=$'\e[31m' c_green=$'\e[32m'
  c_yellow=$'\e[33m' c_magenta=$'\e[35m' c_cyan=$'\e[36m'
else
  c_reset="" c_bold="" c_dim="" c_red="" c_green="" c_yellow="" c_magenta="" c_cyan=""
fi

log() { printf '%s[%s]%s %s\n' "$c_dim" "$(date +%H:%M:%S)" "$c_reset" "$*"; }

notify() {
  local title=$1 message=$2 url=$3

  if command -v terminal-notifier >/dev/null; then
    # Piped: -message parses values starting with brackets, quotes or "<"
    printf '%s' "$message" | terminal-notifier -title "$title" -open "$url" -sound default >/dev/null ||
      log "Notification failed: $title"
    return
  fi

  osascript -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name "default"' \
    -e 'end run' "$title" "$message" || log "Notification failed: $title"
}

# Fields are joined by \x1f, not tabs: bash's read collapses consecutive tabs, dropping empty fields
sep=$'\x1f'

# Capped at 30 PRs: GraphQL cost scales with requested page sizes (~20 points per poll)
fetch_prs() {
  local query="is:pr is:open draft:false involves:@me" repo
  for repo in "${repos[@]}"; do query+=" repo:$repo"; done

  gh api graphql -f q="$query" -f query='
    query($q: String!) {
      search(query: $q, type: ISSUE, first: 30) {
        nodes {
          ... on PullRequest {
            number title url reviewDecision
            author { login }
            repository { nameWithOwner }
            labels(first: 20) { nodes { name } }
            commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
            comments(last: 30) { nodes { ...c } }
            reviews(last: 20) { nodes { ...c state comments(first: 1) { totalCount nodes { body } } } }
            reviewThreads(last: 20) {
              nodes {
                root: comments(first: 1) { nodes { ...c } }
                recent: comments(last: 10) { nodes { ...c } }
              }
            }
          }
        }
      }
    }
    fragment c on Comment {
      id body createdAt
      author { login }
      ... on IssueComment { url }
      ... on PullRequestReview { url }
      ... on PullRequestReviewComment { url }
    }'
}

pr_rows() {
  jq -r '.data.search.nodes[] | [
    .repository.nameWithOwner, (.number | tostring), (.author.login // "ghost"), .url,
    ([.labels.nodes[].name] | join(",")), (.reviewDecision // ""),
    (.commits.nodes[0].commit.statusCheckRollup.state // ""), .title
  ] | join("\u001f")' <<<"$1"
}

# One row per comment or review by someone else that matters to you. On your own PRs:
# every conversation comment and every review (inline comments roll up into their
# review). Elsewhere: @-mentions, and comments following yours in a review thread.
# Earlier kinds win when a comment matches several.
comment_events() {
  jq -r --arg me "$me" '
    def by_me: (.author.login // "") == $me;
    .data.search.nodes[]
    | .repository.nameWithOwner as $repo | (.number | tostring) as $number | .title as $title
    | (.author.login == $me) as $my_pr
    | [
        (select($my_pr) | .reviews.nodes[]
          | select((by_me | not) and (.state == "APPROVED" or .state == "CHANGES_REQUESTED" or .state == "COMMENTED"))
          | select(.state != "COMMENTED" or .body != "" or .comments.totalCount > 0)
          | .body = (if .body == "" then .comments.nodes[0].body // "" else .body end)
          | . + {kind: (.state | ascii_downcase)}),
        (select($my_pr) | .comments.nodes[] | select(by_me | not) | . + {kind: "comment"}),
        ((.comments.nodes[], .reviews.nodes[], (select($my_pr | not) | .reviewThreads.nodes[] | .root.nodes[], .recent.nodes[]))
          | select((by_me | not) and (.body | test("(^|[^\\w-])@" + $me + "(?![\\w-])"; "i")))
          | . + {kind: "mention"}),
        (select($my_pr | not) | .reviewThreads.nodes[]
          | ([.root.nodes[], .recent.nodes[]] | unique_by(.id)) as $thread
          | ([$thread[] | select(by_me) | .createdAt] | min) as $mine
          | select($mine != null)
          | $thread[] | select((by_me | not) and .createdAt > $mine)
          | . + {kind: "reply"})
      ]
    | unique_by(.id)[]
    | [.id, .kind, $repo, $number, (.author.login // "ghost"), .url,
       (.body | gsub("<!--[\\s\\S]*?-->"; "") | gsub("\\s+"; " ") | ltrimstr(" ") | .[0:120]), $title]
    | join("\u001f")' <<<"$1"
}

my_review_state() {
  gh api "repos/$1/pulls/$2/reviews" --paginate \
    --jq ".[] | select(.user.login == \"$me\" and .state != \"COMMENTED\" and .state != \"PENDING\") | .state" |
    tail -n1
}

# Prints the PR's changed files that fall under an -x path
excluded_files() {
  local files file path
  [ ${#excluded_paths[@]} -eq 0 ] && return

  files=$(gh api "repos/$1/pulls/$2/files" --paginate --jq '.[].filename') || return
  while IFS= read -r file; do
    for path in "${excluded_paths[@]}"; do
      case $file in
        "$path" | "$path"/*) printf '%s\n' "$file" && break ;;
      esac
    done
  done <<<"$files"
}

maybe_approve() {
  local repo=$1 number=$2 url=$3 title=$4 state blocked

  [[ $failed_approvals == *" $url "* ]] && return

  if ! state=$(my_review_state "$repo" "$number"); then
    log "Review lookup failed for $url"
    return
  fi
  [[ $state == APPROVED || $state == CHANGES_REQUESTED ]] && return

  if ! blocked=$(excluded_files "$repo" "$number"); then
    log "File lookup failed for $url"
    return
  fi
  if [ -n "$blocked" ]; then
    [[ $blocked_approvals == *" $url "* ]] && return
    blocked_approvals+="$url "
    log "Not auto-approving $url: changes $(head -n1 <<<"$blocked")"
    notify "Not auto-approving #$number" "Changes $(head -n1 <<<"$blocked")" "$url"
    return
  fi

  if $dry_run; then
    log "DRY RUN: would approve $url"
    return
  fi

  if ! gh pr review "$number" -R "$repo" --approve >/dev/null; then
    log "Approve failed for $url, not retrying"
    failed_approvals+="$url "
    return
  fi

  log "Approved $url"
  notify "Auto-approved #$number" "$title" "$url"
}

# Pads by character count; printf's %-Ns pads by bytes, which breaks on non-ASCII
pad() { printf '%s%*s' "$1" $(($2 - ${#1})) ''; }

# OSC 8 hyperlink, only on a TTY; the padding stays outside the link
link_cell() {
  local url=$1 text=$2 width=$3
  if $is_tty; then
    printf '\e]8;;%s\e\\%s\e]8;;\e\\' "$url" "$text"
  else
    printf '%s' "$text"
  fi
  printf '%*s' $((width - ${#text})) ''
}

repeat() {
  local s
  printf -v s '%*s' "$2" ''
  printf '%s' "${s// /$1}"
}

label_color() {
  case $1 in
    ssa-ship) printf '%s' "$c_green" ;;
    ssa-show) printf '%s' "$c_yellow" ;;
    ssa-ask) printf '%s' "$c_red" ;;
    *) printf '%s' "$c_dim" ;;
  esac
}

colored() { printf '%s%s%s' "$1" "$(pad "$2" "$3")" "$c_reset"; }

review_cell() {
  case $1 in
    APPROVED) colored "$c_green" approved "$2" ;;
    CHANGES_REQUESTED) colored "$c_red" changes "$2" ;;
    REVIEW_REQUIRED) colored "$c_yellow" pending "$2" ;;
    *) colored "$c_dim" - "$2" ;;
  esac
}

ci_cell() {
  case $1 in
    SUCCESS) colored "$c_green" "✓ passed" "$2" ;;
    FAILURE | ERROR) colored "$c_red" "✗ failed" "$2" ;;
    PENDING | EXPECTED) colored "$c_yellow" "● running" "$2" ;;
    *) colored "$c_dim" - "$2" ;;
  esac
}

print_list() {
  local rows=$1 repo number author url labels review ci title count=0
  local w_repo=4 w_num=4 w_author=6 w_title=5 w_labels=6 w_review=8 w_ci=9

  while IFS=$sep read -r repo number author url labels review ci title; do
    [ -z "$url" ] && continue
    count=$((count + 1))
    labels=${labels//,/, }
    [ ${#repo} -gt $w_repo ] && w_repo=${#repo}
    [ $((${#number} + 1)) -gt $w_num ] && w_num=$((${#number} + 1))
    [ ${#author} -gt $w_author ] && w_author=${#author}
    [ ${#title} -gt $w_title ] && w_title=${#title}
    [ ${#labels} -gt $w_labels ] && w_labels=${#labels}
  done <<<"$rows"

  log "${#repos[@]} repo(s), $count open PR(s)"
  [ $count -eq 0 ] && return

  local cols
  cols=$({ stty size </dev/tty; } 2>/dev/null | cut -d' ' -f2) || true
  local max_title=$((${cols:-${COLUMNS:-160}} - w_repo - w_num - w_author - w_labels - w_review - w_ci - 22))
  [ $max_title -lt 20 ] && max_title=20
  [ $w_title -gt $max_title ] && w_title=$max_title

  local b="${c_dim}│${c_reset}"
  border() {
    printf '%s%s' "$c_dim" "$1"
    printf '%s%s' "$(repeat ─ $((w_repo + 2)))" "$2"
    printf '%s%s' "$(repeat ─ $((w_num + 2)))" "$2"
    printf '%s%s' "$(repeat ─ $((w_author + 2)))" "$2"
    printf '%s%s' "$(repeat ─ $((w_title + 2)))" "$2"
    printf '%s%s' "$(repeat ─ $((w_review + 2)))" "$2"
    printf '%s%s' "$(repeat ─ $((w_ci + 2)))" "$2"
    printf '%s%s%s\n' "$(repeat ─ $((w_labels + 2)))" "$3" "$c_reset"
  }

  border ┌ ┬ ┐
  printf '%s %s%s%s %s %s%s%s %s %s%s%s %s %s%s%s %s %s%s%s %s %s%s%s %s %s%s%s %s\n' \
    "$b" "$c_bold" "$(pad Repo $w_repo)" "$c_reset" \
    "$b" "$c_bold" "$(pad PR $w_num)" "$c_reset" \
    "$b" "$c_bold" "$(pad Author $w_author)" "$c_reset" \
    "$b" "$c_bold" "$(pad Title $w_title)" "$c_reset" \
    "$b" "$c_bold" "$(pad Review $w_review)" "$c_reset" \
    "$b" "$c_bold" "$(pad CI $w_ci)" "$c_reset" \
    "$b" "$c_bold" "$(pad Labels $w_labels)" "$c_reset" "$b"
  border ├ ┼ ┤

  local author_color label labels_cell labels_len
  while IFS=$sep read -r repo number author url labels review ci title; do
    [ -z "$url" ] && continue

    [ ${#title} -gt $w_title ] && title="${title:0:$((w_title - 1))}…"

    author_color=""
    [ "$author" = "$me" ] && author_color=$c_cyan

    labels_cell=""
    labels_len=${#labels}
    [ -n "$labels" ] && labels_len=$((labels_len + $(tr -cd , <<<"$labels" | wc -c)))
    while IFS= read -r label; do
      [ -z "$label" ] && continue
      [ -n "$labels_cell" ] && labels_cell+="$c_dim, $c_reset"
      labels_cell+="$(label_color "$label")$label$c_reset"
    done <<<"${labels//,/$'\n'}"

    printf '%s %s %s %s%s%s %s %s%s%s %s %s %s %s %s %s %s %s%*s %s\n' \
      "$b" "$(pad "$repo" $w_repo)" \
      "$b" "$c_magenta" "$(link_cell "$url" "#$number" $w_num)" "$c_reset" \
      "$b" "$author_color" "$(pad "$author" $w_author)" "$c_reset" \
      "$b" "$(link_cell "$url" "$title" $w_title)" \
      "$b" "$(review_cell "$review" $w_review)" \
      "$b" "$(ci_cell "$ci" $w_ci)" \
      "$b" "$labels_cell" $((w_labels - labels_len)) '' "$b"
  done <<<"$rows"
  border └ ┴ ┘
}

log "Watching ${repos[*]} as $me every ${interval}s (auto-approve: $approve_label)"
first_poll=true

while true; do
  if ! raw=$(fetch_prs); then
    log "Fetch failed, retrying in ${interval}s"
    sleep "$interval"
    continue
  fi

  prs=$(pr_rows "$raw")
  events=$(comment_events "$raw")
  current=$(cut -d"$sep" -f4 <<<"$prs" | sed '/^$/d' | sort)

  new_urls=""
  [ -f "$seen_file" ] && new_urls=$(comm -13 "$seen_file" <(printf '%s\n' "$current") | sed '/^$/d')
  if $first_poll || [ -n "$new_urls" ] || [ "$current" != "$(cat "$seen_file")" ]; then
    print_list "$prs"
  fi
  first_poll=false
  printf '%s\n' "$current" >"$seen_file"

  # fd 3 keeps gh/osascript from consuming the loop's input
  while IFS=$sep read -r repo number author url labels review ci title <&3; do
    [ -z "$url" ] && continue

    if grep -qxF "$url" <<<"$new_urls"; then
      log "New: $url"
      notify "New PR #$number ($repo)" "$title - by $author" "$url"
    fi

    [ "$author" = "$me" ] && continue
    [[ ",$labels," == *",$approve_label,"* ]] && maybe_approve "$repo" "$number" "$url" "$title"
  done 3<<<"$prs"

  if [ -f "$events_file" ]; then
    while IFS=$sep read -r id kind repo number author url snippet title <&3; do
      [ -z "$id" ] && continue
      grep -qxF "$id" "$events_file" && continue

      case $kind in
        approved) verb="approved" ;;
        changes_requested) verb="requested changes on" ;;
        commented) verb="commented on" ;;
        comment) verb="commented on" ;;
        mention) verb="mentioned you on" ;;
        *) verb="replied to you on" ;;
      esac
      log "@$author $verb $repo#$number: $url"
      notify "@$author $verb #$number" "${snippet:-$title}" "$url"
    done 3<<<"$events"
  fi
  { [ -f "$events_file" ] && cat "$events_file"; cut -d"$sep" -f1 <<<"$events"; } |
    sed '/^$/d' | awk '!seen[$0]++' | tail -n 5000 >"$events_file.tmp"
  mv "$events_file.tmp" "$events_file"

  sleep "$interval"
done
